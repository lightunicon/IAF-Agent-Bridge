{
  "name": "iaf-agent-bridge",
  "version": "1.1.0",
  "description": "Send work from Codex or another MCP host to Cursor Agent and continue the same session.",
  "author": {
    "name": "lightunicon",
    "url": "https://github.com/lightunicon"
  },
  "homepage": "https://github.com/lightunicon/IAF-Agent-Bridge",
  "repository": "https://github.com/lightunicon/IAF-Agent-Bridge",
  "license": "MIT",
  "keywords": [
    "mcp",
    "cursor",
    "codex",
    "acp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "iaf-agent-bridge": {
      "command": "node",
      "args": [
        "./bin/iaf-agent-bridge.mjs"
      ],
      "cwd": "."
    }
  },
  "interface": {
    "displayName": "IAF Agent Bridge",
    "shortDescription": "Continue Cursor sessions until the work is done",
    "developerName": "lightunicon",
    "category": "Developer Tools",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/lightunicon/IAF-Agent-Bridge",
    "privacyPolicyURL": "https://github.com/lightunicon/IAF-Agent-Bridge/blob/main/PRIVACY.md",
    "termsOfServiceURL": "https://github.com/lightunicon/IAF-Agent-Bridge/blob/main/TERMS.md",
    "defaultPrompt": "Have Cursor implement this, then continue the same Cursor session until the requested work is complete."
  }
}
